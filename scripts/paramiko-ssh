#!/home/z/.venv/bin/python
"""
SSH-транспорт для git в песочнице (нет /usr/bin/ssh).

Минимальная имитация CLI openssh: `[-p port] [-o opt] [-i key] host command…`.
Используется через: git -c core.sshCommand=/home/z/my-project/scripts/paramiko-ssh push …

Ключ ищется в порядке:
  1. /home/z/my-project/git-helpers/deploy_key — постоянное хранилище ВНУТРИ
     воркспейса: переживает пересборку контейнера (в отличие от ~/.ssh).
  2. ~/.ssh/id_ed25519 — fallback.
Если ключа нигде нет: bash scripts/git-restore.sh (он подскажет).
"""
import os
import sys
import threading

import paramiko

KEY_CANDIDATES = (
    "/home/z/my-project/git-helpers/deploy_key",
    os.path.expanduser("~/.ssh/id_ed25519"),
)


def load_key() -> paramiko.PKey:
    last_exc: Exception | None = None
    for path in KEY_CANDIDATES:
        if not os.path.exists(path):
            continue
        try:
            return paramiko.Ed25519Key.from_private_key_file(path)
        except Exception as exc:  # noqa: BLE001
            last_exc = exc
    raise SystemExit(
        "paramiko-ssh: deploy-ключ не найден ни в одном из путей: "
        f"{', '.join(KEY_CANDIDATES)} ({last_exc}). "
        "Запусти: bash /home/z/my-project/scripts/git-restore.sh"
    )


def main() -> int:
    args = sys.argv[1:]
    port = 22
    user = "git"

    while args and args[0].startswith("-"):
        a = args.pop(0)
        if a == "-p":
            port = int(args.pop(0))
        elif a == "-l":
            user = args.pop(0)
        elif a in ("-o", "-i", "-L", "-R"):
            args.pop(0)  # значение игнорируем
        # прочие флаги (-T, -q, …) игнорируем

    if not args:
        print("paramiko-ssh: no host", file=sys.stderr)
        return 255
    host = args.pop(0)
    if "@" in host:  # git@github.com → user=git, host=github.com
        user, _, host = host.partition("@")
    if ":" in host and host.endswith("]:"):  # [host]:port
        host, _, p = host[:-1].rpartition("[")
        port = int(p)
    command = " ".join(args)

    pkey = load_key()
    client = paramiko.SSHClient()
    client.set_missing_host_key_policy(paramiko.AutoAddPolicy())
    client.connect(
        host,
        port=port,
        username=user,
        pkey=pkey,
        look_for_keys=False,
        allow_agent=False,
        timeout=20,
    )
    stdin, stdout, stderr = client.exec_command(command, get_pty=False)
    chan = stdout.channel

    def pump_stdin() -> None:
        try:
            while True:
                data = sys.stdin.buffer.read(65536)
                if not data:
                    break
                chan.sendall(data)
        except Exception:
            pass
        finally:
            try:
                chan.shutdown_write()
            except Exception:
                pass

    def pump_stderr() -> None:
        try:
            while True:
                data = stderr.channel.recv_stderr(65536)
                if not data:
                    break
                sys.stderr.buffer.write(data)
                sys.stderr.buffer.flush()
        except Exception:
            pass

    threading.Thread(target=pump_stdin, daemon=True).start()
    threading.Thread(target=pump_stderr, daemon=True).start()

    try:
        while True:
            data = chan.recv(65536)
            if not data:
                break
            sys.stdout.buffer.write(data)
            sys.stdout.buffer.flush()
    except Exception as exc:
        print(f"paramiko-ssh: {exc}", file=sys.stderr)

    code = chan.recv_exit_status() if not chan.closed else 255
    client.close()
    return code


if __name__ == "__main__":
    sys.exit(main())
